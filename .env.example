# ============================================
# PAIDEIA - Variables de Entorno
# ============================================

# --------------------------------------------
# Proveedor de LLM: "openai" | "google"
# --------------------------------------------
LLM_PROVIDER=openai

# --------------------------------------------
# OpenAI Configuration
# --------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --------------------------------------------
# Google AI Configuration (Gemini/Gemma)
# --------------------------------------------
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemma-3-27b-it
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# --------------------------------------------
# Proveedor de Embeddings: "openai" | "google"
# --------------------------------------------
EMBEDDING_PROVIDER=openai

# --------------------------------------------
# SurrealDB Configuration
# --------------------------------------------
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_NAMESPACE=paideia
SURREAL_DATABASE=education
SURREAL_USER=root
SURREAL_PASS=root

# --------------------------------------------
# RAG Configuration
# --------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_CONTEXT_TOKENS=4096
SIMILARITY_THRESHOLD=0.7

# --------------------------------------------
# Model Parameters
# --------------------------------------------
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# --------------------------------------------
# Feature Flags
# --------------------------------------------
ENABLE_GRAPH_RAG=true
ENABLE_CACHE=true
ENABLE_FEEDBACK=true

# --------------------------------------------
# User API Keys Configuration
# --------------------------------------------
# Permitir que los usuarios envíen sus propias API keys
# desde el frontend (headers X-OpenAI-Key, X-Google-Key)
ALLOW_USER_API_KEYS=true

# Si true, requiere que haya al menos una API key
# (ya sea del servidor o del usuario) para funcionar
REQUIRE_API_KEY=false
